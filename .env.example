# Copy to .env and adjust as needed. All variables are optional; sane
# defaults for public Polish/EU registries are baked into the server.

# Client-facing language for reports and tool output: "pl" (default) or "en".
AML_DEFAULT_LANGUAGE=pl

# Registry endpoints (defaults point at the official public APIs).
# AML_KRS_API_BASE=https://api-krs.ms.gov.pl/api/krs
# AML_CEIDG_API_BASE=https://dane.biznes.gov.pl/api/ceidg/v2
# AML_WHITE_LIST_API_BASE=https://wl-api.mf.gov.pl/api/search
# AML_CRBR_API_BASE=https://crbr.podatki.gov.pl/adcrbr/api/wyszukajSpolke
# AML_OPENSANCTIONS_API_BASE=https://api.opensanctions.org
# AML_MSWIA_SANCTIONS_LIST_URL=https://www.gov.pl/attachment/lista-osob-i-podmiotow-objetych-sankcjami.json

# Optional OpenSanctions API key for higher rate limits.
# AML_OPENSANCTIONS_API_KEY=

# CEIDG (sole trader register) JWT bearer token. Required for CEIDG lookups;
# request one at https://dane.biznes.gov.pl. Without it, verify_company_basic
# falls back to KRS-only results (companies, not sole traders).
# AML_CEIDG_API_KEY=

# HTTP behaviour
# AML_HTTP_TIMEOUT_SECONDS=15
# AML_HTTP_MAX_RETRIES=3

# Sanctions/PEP fuzzy-match threshold, 0.0-1.0.
# AML_SANCTIONS_MATCH_THRESHOLD=0.7

# Directory for persisted Markdown/PDF risk cards.
# AML_OUTPUT_DIR=./output
